  "policy": {
    "primaryRegion": "KR",
    "verifiedRequires": ["provider", "dataset", "recordId"],
    "qualityStates": ["verified", "approximate", "estimated", "unknown"],
    "rules": [
      "Never promote an estimated or approximate value to verified without traceable source metadata.",
      "Preserve the source record identifier and dataset name at ingestion.",
      "Normalize nutrients to a declared gram basis before recommendation math.",
      "Treat serving text as display metadata; basisG owns nutrient scaling.",
      "Do not expose API keys in repository files or client bundles."
    ]
  },
