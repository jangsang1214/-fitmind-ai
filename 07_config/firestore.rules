rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function validConsentDocument(data) {
      return !('consent' in data) || (
        data.consent is map
        && data.consent.keys().hasOnly(['globalLearning','analytics','updatedAt'])
        && (!('globalLearning' in data.consent) || data.consent.globalLearning is bool)
        && (!('analytics' in data.consent) || data.consent.analytics is bool)
      );
    }
    function validStateOwner(data, userId) {
      return !('meta' in data) || (
        data.meta is map
        && (!('syncOwnerUid' in data.meta) || data.meta.syncOwnerUid == null || data.meta.syncOwnerUid == userId)
      );
    }
    function validHistory(data, userId, domain) {
      return data is map
        && data.ownerUid == userId
        && data.domain == domain
        && data.recordId is string
        && data.record is map;
    }
    function globalLearningConsented() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.consent.globalLearning == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validConsentDocument(request.resource.data);
      allow delete: if isOwner(userId);

      match /app/state {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validStateOwner(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /workoutHistory/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHistory(request.resource.data, userId, 'workouts');
      }
      match /mealHistory/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHistory(request.resource.data, userId, 'meals');
      }
      match /runHistory/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHistory(request.resource.data, userId, 'runs');
      }
      match /bodyHistory/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHistory(request.resource.data, userId, 'body');
      }
      match /recoverySnapshots/{snapshotId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }

      /* No broad owner wildcard: every user subcollection must be declared explicitly. */
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /globalLearningEvents/{eventId} {
      allow create: if globalLearningConsented()
        && request.resource.data.keys().hasOnly(['eventType','context','outcome','actionSummary','quality','createdAt'])
        && request.resource.data.keys().hasAll(['eventType','context','outcome','actionSummary','quality','createdAt'])
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() <= 80
        && request.resource.data.context is map
        && request.resource.data.outcome is map
        && request.resource.data.actionSummary is string
        && request.resource.data.actionSummary.size() <= 500
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    match /globalPatterns/{patternId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
