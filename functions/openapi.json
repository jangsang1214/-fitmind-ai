{
  "openapi": "3.1.0",
  "info": {"title": "GARANG Agent Context API", "version": "1.0.0"},
  "servers": [{"url": "https://asia-northeast3-fitfind-ai.cloudfunctions.net/api"}],
  "paths": {
    "/agent/context": {
      "get": {
        "operationId": "getAgentContext",
        "summary": "Read the authenticated GARANG user's current context",
        "security": [{"firebaseIdToken": []}],
        "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}}],
        "responses": {
          "200": {"description": "Authenticated user context"},
          "401": {"description": "Missing, invalid, expired or revoked Firebase ID token"},
          "405": {"description": "GET is the only allowed method"},
          "503": {"description": "Firestore is temporarily unavailable"}
        }
      }
    }
  },
  "components": {"securitySchemes": {"firebaseIdToken": {"type": "http", "scheme": "bearer", "bearerFormat": "Firebase ID token"}}}
}
